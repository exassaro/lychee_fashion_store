# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by the seed / create-admin scripts. NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp number in international format, digits only, no "+" (e.g. 919876543210).
# Used as a fallback when the WhatsApp number in Admin → Settings is empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Public site URL, no trailing slash (used for SEO, sitemap and WhatsApp links)
NEXT_PUBLIC_SITE_URL=https://lychee.vercel.app
